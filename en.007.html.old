<script>
  const cta = document.querySelector('.bottom-cta');
  const topFloat = document.querySelector('.top-float');
  function toggleFloatingButtons(){
    const show = window.scrollY > 8;
    if (cta) cta.classList.toggle('visible', show);
    if (topFloat) topFloat.classList.toggle('visible', show);
  }
  if (topFloat) {
    topFloat.addEventListener('click', () => window.scrollTo({top:0, behavior:'smooth'}));
  }
  toggleFloatingButtons();
  window.addEventListener('scroll', toggleFloatingButtons, {passive:true});
</script>
<script>
(function(){
  let userInteracted = false;
  let autoTimer = null;

  function stopAutoScroll(){
    userInteracted = true;
    if (autoTimer) {
      clearInterval(autoTimer);
      autoTimer = null;
    }
  }

  ["touchstart", "wheel", "mousedown", "keydown", "pointerdown"].forEach(function(eventName){
    window.addEventListener(eventName, stopAutoScroll, { passive: true, once: true });
  });

  function startAutoScroll(){
    if (userInteracted || window.scrollY > 20 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let autoPosition = window.scrollY;
    autoTimer = setInterval(function(){
      if (userInteracted) {
        clearInterval(autoTimer);
        autoTimer = null;
        return;
      }

      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      if (window.scrollY >= maxScroll - 2) {
        clearInterval(autoTimer);
        autoTimer = null;
        return;
      }

      autoPosition += 0.45;
      window.scrollTo(0, autoPosition);
    }, 16);
  }

  window.addEventListener("load", function(){
    setTimeout(startAutoScroll, 5000);
  });
})();
</script>
